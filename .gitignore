# ==========================================
# MAKARYA MONOREPO .gitignore
# ==========================================

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Environment Variables (CRITICAL SECURITY)
.env
.env.local
.env.*.local
*.pem
*.key

# ------------------------------------------
# Backend (Python / FastAPI)
# ------------------------------------------
backend/venv/
backend/env/
backend/.venv/
**/__pycache__/
*.py[cod]
*$py.class
*.sqlite3
*.db
backend/get-pip.py
.pytest_cache/
.coverage

# ------------------------------------------
# Frontend Web (React / Vite)
# ------------------------------------------
web/node_modules/
web/dist/
web/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------
# Mobile (Expo / React Native)
# ------------------------------------------
mobile/node_modules/
**/.expo/
mobile/dist/
mobile/dist_test/
mobile/web-build/
mobile/android/app/build/
mobile/android/build/
mobile/android/.gradle/
mobile/android/app/.cxx/
mobile/android/app/release/
*.apk
*.aab
*.jks
*.keystore
mobile/android/app/google-services.json
mobile/ios/Pods/
mobile/ios/build/
.metro-health-check*
