# Application Settings
PROJECT_NAME=Makarya API
APP_ENV=development
API_V1_STR=/v1
DEBUG=True

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=makarya_db

# Security & JWT
SECRET_KEY=your_jwt_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (Frontend URLs dipisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ==============================================================================
# MIDTRANS PAYMENT GATEWAY CONFIGURATION
# Dapatkan Server Key & Client Key dari Dashboard Midtrans:
# Sandbox: https://dashboard.sandbox.midtrans.com -> Settings -> Access Keys
# Production: https://dashboard.midtrans.com -> Settings -> Access Keys
# ==============================================================================
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_MERCHANT_ID=Gxxxxxxxx
MIDTRANS_IS_PRODUCTION=False

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth (Mobile & Web)
GOOGLE_CLIENT_ID=your_google_client_id_mobile
GOOGLE_CLIENT_SECRET=your_google_client_secret_mobile
GOOGLE_CLIENT_ID_WEB=your_google_client_id_web
GOOGLE_CLIENT_SECRET_WEB=your_google_client_secret_web

